# Copy to .env (Bun loads it when the API starts from apps/api).

# The server's copy of the game history: the Postgres from docker-compose.yml, or
# pglite:<folder> for an embedded one without Docker. Unset: no history on the server.
DATABASE_URL=postgres://chessy:chessy@localhost:5433/chessy

# The AI coach on Claude through the API (https://console.anthropic.com). Never commit a key.
# ANTHROPIC_API_KEY=

# The coach on Claude Code (your subscription) is on when `claude` is installed; switch it off with:
# COACH_CLAUDE_HEADLESS=off

# The coach on a local model in Ollama (start it with OLLAMA_CONTEXT_LENGTH=16384 ollama serve).
# COACH_OLLAMA=on
# COACH_OLLAMA_MODEL=qwen3:14b

# Any other OpenAI-compatible API, e.g. OpenRouter.
# COACH_OPENAI_URL=https://openrouter.ai/api/v1
# COACH_OPENAI_MODEL=deepseek/deepseek-chat
# COACH_OPENAI_KEY=
