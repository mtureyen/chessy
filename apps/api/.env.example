# Copy to .env (Bun loads it when the API starts from apps/api).

# The server's copy of the game history: the Postgres from docker-compose.yml, or
# pglite:<folder> for an embedded one without Docker. Unset: no history on the server.
DATABASE_URL=postgres://chessy:chessy@localhost:5433/chessy

# The AI coach on Claude through the API (https://console.anthropic.com). Never commit a key.
# ANTHROPIC_API_KEY=
