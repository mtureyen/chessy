{
  "name": "@chessy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev:recorded": "CHESSY_SOURCES=recorded bun --watch src/main.ts",
    "engine:native": "bun scripts/fetch-stockfish.ts",
    "bots:calibrate": "bun scripts/calibrate-bots.ts",
    "maia:fetch": "bun scripts/fetch-maia.ts",
    "maia:spike": "bun scripts/maia-spike.ts",
    "review:bench": "bun scripts/review-bench.ts",
    "bench:references": "bun scripts/collect-references.ts"
  },
  "dependencies": {
    "@chessy/analysis": "workspace:*",
    "@chessy/chess": "workspace:*",
    "@chessy/contracts": "workspace:*",
    "@chessy/library": "workspace:*",
    "@chessy/maia": "workspace:*",
    "@chessy/play": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "hono": "^4.13.14",
    "onnxruntime-web": "1.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chessy/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4"
  }
}
