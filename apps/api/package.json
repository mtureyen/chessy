{
  "name": "@pawnia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev:recorded": "PAWNIA_SOURCES=recorded bun --watch src/main.ts",
    "engine:native": "bun scripts/fetch-stockfish.ts",
    "bots:calibrate": "bun scripts/calibrate-bots.ts",
    "maia:fetch": "bun scripts/fetch-maia.ts",
    "maia:spike": "bun scripts/maia-spike.ts",
    "review:bench": "bun scripts/review-bench.ts",
    "bench:references": "bun scripts/collect-references.ts",
    "library:build": "bun scripts/build-library.ts",
    "puzzles:fetch": "bun scripts/fetch-puzzles.ts",
    "themes:validate": "bun scripts/validate-themes.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun scripts/check-postgres.ts",
    "coach:check": "bun scripts/check-coach.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@pawnia/analysis": "workspace:*",
    "@pawnia/chess": "workspace:*",
    "@pawnia/coach": "workspace:*",
    "@pawnia/contracts": "workspace:*",
    "@pawnia/history": "workspace:*",
    "@pawnia/library": "workspace:*",
    "@pawnia/maia": "workspace:*",
    "@pawnia/play": "workspace:*",
    "@electric-sql/pglite": "0.5.10",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@scalar/hono-api-reference": "^0.12.14",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.14",
    "onnxruntime-web": "1.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pawnia/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "0.31.11"
  }
}
