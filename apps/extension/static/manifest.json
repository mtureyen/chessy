{
  "manifest_version": 3,
  "name": "Open in Chessy",
  "version": "0.1.0",
  "description": "Opens the lichess or chess.com game you are looking at in Chessy, for a free review. Reads only the page address.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://www.chess.com/*",
        "https://www.chessigma.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
