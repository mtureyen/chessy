{
  "name": "chessy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "turbo run e2e",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "bun --bun depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "bun run lint && bun run format:check && bun run check:boundaries && turbo run typecheck test build"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.7.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
