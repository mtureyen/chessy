{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["node_modules/.tmp/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["STOCKFISH_INTEGRATION", "MAIA_INTEGRATION", "STOCKFISH_PATH", "MAIA_MODEL_PATH"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["E2E_API_PORT", "E2E_WEB_PORT", "CI", "PLAYWRIGHT_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
